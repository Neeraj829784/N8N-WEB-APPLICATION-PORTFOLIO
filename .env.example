# Production origin only, e.g. https://your-domain.com (no paths or credentials).
# Rebuild and redeploy after changing these settings.
SITE_URL=https://neerajwork.in
SITE_INDEXABLE=false

# Automatic email delivery (recommended). Server-only; never use NEXT_PUBLIC_.
# Add a Resend sending API key and a bare sender address on your verified domain.
# The API key stays blank in this template. Delivery stays off until it is added.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=enquiries@notify.neerajwork.in
# Fixed recipient inbox. Never supplied by a visitor.
CONTACT_TO_EMAIL=neerajvasupalli200@gmail.com

# Alternative only: n8n production webhook (not required for Resend delivery).
# Used only when RESEND_API_KEY and CONTACT_FROM_EMAIL are both blank.
# Use HTTPS. Partial email configuration disables delivery instead of falling back.
CONTACT_WEBHOOK_URL=
# Optional Bearer token configured on the receiving webhook.
CONTACT_WEBHOOK_TOKEN=
